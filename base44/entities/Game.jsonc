{
  "name": "Game",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "multiplayer",
        "campaign"
      ],
      "default": "multiplayer"
    },
    "status": {
      "type": "string",
      "enum": [
        "lobby",
        "active",
        "paused",
        "complete",
        "cancelled"
      ],
      "default": "lobby"
    },
    "pausedStatus": {
      "type": [
        "string",
        "null"
      ],
      "description": "The status the front held before it was suspended, restored on resume"
    },
    "mapId": {
      "type": "string"
    },
    "planetId": {
      "type": "string",
      "default": "cindara"
    },
    "worldModel": {
      "type": "string",
      "enum": [
        "hex",
        "macro"
      ],
      "default": "hex"
    },
    "macro": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "weather": {
      "type": "string",
      "default": "clear"
    },
    "attrition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "factionSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "turnOrder": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "currentTurnIndex": {
      "type": "integer",
      "default": 0
    },
    "turnNumber": {
      "type": "integer",
      "default": 1
    },
    "territoryStates": {
      "type": "object",
      "additionalProperties": true
    },
    "treasuries": {
      "type": "object",
      "additionalProperties": true
    },
    "armies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "diplomacy": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "activeBattle": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "lastBattle": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "battleArchives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "lastSeen": {
      "type": "object",
      "additionalProperties": true
    },
    "combatLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "statHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "campaignWinCondition": {
      "type": "object",
      "additionalProperties": true
    },
    "hostUserId": {
      "type": "string"
    },
    "winnerSlot": {
      "type": "integer"
    },
    "loggedToSheet": {
      "type": "boolean",
      "default": false
    },
    "summaryLogged": {
      "type": "boolean",
      "default": false
    },
    "chronicleDocUrl": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}