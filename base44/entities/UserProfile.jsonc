{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string"
    },
    "avatarUrl": {
      "type": "string"
    },
    "presence": {
      "type": "string",
      "enum": [
        "on_duty",
        "reserve",
        "dark"
      ],
      "default": "on_duty",
      "description": "How this commander chooses to appear on the roll"
    },
    "lastSeenAt": {
      "type": "string",
      "format": "date-time"
    },
    "gamesPlayed": {
      "type": "integer",
      "default": 0
    },
    "gamesWon": {
      "type": "integer",
      "default": 0
    },
    "campaignsCompleted": {
      "type": "integer",
      "default": 0
    },
    "mapsCreated": {
      "type": "integer",
      "default": 0
    },
    "isAdmin": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "displayName"
  ],
  "rls": {
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}